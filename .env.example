# --- Free-tier Gemini (Google AI Studio) — recommended for demos ---
# Create a key at https://aistudio.google.com/apikey
# Keep GOOGLE_GENAI_USE_VERTEXAI=FALSE so you stay on the free Gemini API tier.
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-api-key-here

# Your GCP project (metadata / future Vertex use — not required for free-tier runs)
GOOGLE_CLOUD_PROJECT=agentthree-ai-dev-511709
GOOGLE_CLOUD_PROJECT_NUMBER=31543876598
GOOGLE_CLOUD_LOCATION=us-central1

# Model on the free tier (flash is cheapest / fastest for demos)
GEMINI_MODEL=gemini-2.0-flash

# When true, skip live Gemini and use deterministic fixtures (still hits real MCP + A2A envelopes)
DEMO_MODE=false

# Ports
MCP_PORT=8080
API_PORT=8000
INTAKE_A2A_PORT=9001
PA_A2A_PORT=9002
CDS_A2A_PORT=9003
